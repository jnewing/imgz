# imgz production Caddyfile for FrankenPHP + Laravel Octane.
#
# Based on Octane's FrankenPHP stub, extended to serve uploaded images and
# thumbnails as static files straight from the images directory. The on-disk
# shard is derived from the id, so /i/{id}.{ext} never routes bytes through
# PHP/Octane. The {$CADDY_*} placeholders are substituted by Caddy from the
# environment that `php artisan octane:frankenphp` provides.

{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}

		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode zstd br gzip

		# Serve stored images and thumbnails statically. /i/{id}.{ext} and
		# /i/{id}_thumb.{fmt} map to {ab}/{cd}/{filename} under the images
		# directory (shard derived from the id). Long-lived immutable cache.
		@imgz_file path_regexp imgz ^/i/(([0-9A-Za-z]{2})([0-9A-Za-z]{2})[0-9A-Za-z]{6}(_thumb)?)\.([a-z0-9]{3,4})$
		handle @imgz_file {
			root * /app/storage/app/images
			rewrite * /{re.imgz.2}/{re.imgz.3}/{re.imgz.1}.{re.imgz.5}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
