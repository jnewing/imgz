# imgz - self-hosted environment.
# Copy to .env next to docker-compose.yml and fill in the required values.

# Which image to run (defaults to the published release image).
# IMGZ_IMAGE=ghcr.io/jnewing/imgz:latest
# Host port the app is published on for your reverse proxy to target.
APP_PORT=8000

# Where uploaded images live. Leave as the default to use Docker's managed
# `images` named volume, or set an absolute host path to bind-mount a directory
# you control (created if missing; files are owned by root on the host):
#   IMGZ_IMAGES_PATH=/srv/imgz/images
IMGZ_IMAGES_PATH=images

APP_NAME=imgz
APP_ENV=production
APP_DEBUG=false
# REQUIRED. Generate once with:
#   docker run --rm ghcr.io/jnewing/imgz:latest php artisan key:generate --show
APP_KEY=
# REQUIRED. The public HTTPS URL your reverse proxy serves.
APP_URL=https://imgz.net

# Serves Laravel Octane on FrankenPHP.
OCTANE_SERVER=frankenphp
# Image processing driver: gd (WebP-capable in this image) or imagick.
IMAGE_DRIVER=gd

# Database (the bundled Postgres service).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=imgz
DB_USERNAME=imgz
# REQUIRED. Set a strong password.
DB_PASSWORD=

# Cache / queue / sessions on the bundled Redis service.
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Entrypoint behaviour (app container).
RUN_MIGRATIONS=true
CACHE_CONFIG=true

# PHP upload limits (tune to your max image size).
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=120

# imgz features & limits (see config/imgz.php).
IMGZ_GUEST_UPLOADS=true
IMGZ_REQUIRE_ACCOUNT=false
IMGZ_REGISTRATION=true
IMGZ_MAX_FILES=20
IMGZ_MAX_SIZE_KB=32768
# Serve direct links from a dedicated (cookieless) host or CDN, e.g.
# IMGZ_DIRECT_URL=https://i.imgz.net

# Mail. Defaults to `log` (emails written to the log, nothing sent), which is
# fine for a trial but breaks password resets and email verification. For real
# delivery, use SMTP and point it at your mail server (e.g. Postal):
#   MAIL_MAILER=smtp
#   MAIL_HOST=postal.example.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<smtp credential username>
#   MAIL_PASSWORD=<smtp credential password>
#   MAIL_SCHEME=smtp         # STARTTLS on 587 (auto-negotiated); use `smtps` for implicit TLS on 465
#   MAIL_FROM_ADDRESS=no-reply@imgz.net
#   MAIL_FROM_NAME=imgz
MAIL_MAILER=log
